# Trading Bot v3 Environment - Agressive Profile
# Higher risk / higher return profile.

# MySQL connection for Go trading bot
TRADING_DB_DSN=root:root@tcp(localhost:3306)/trading_db_v3?parseTime=true&charset=utf8

# Instance key for multi-bot support
TRADING_INSTANCE_KEY=v3_aggressive

# Pairs
TRADING_PAIRS=btcidr,ethidr,dogeidr,usdtidr,xautidr

# Bot runtime
BOT_INTERVAL_SEC=30
HTTP_TIMEOUT_SEC=10
BOT_VERBOSE=true

# Portfolio allocation targets (%)
# BTC=35, ETH=25, USDT=20, XAUT=10, DOGE=10
ALLOC_BTCIDR=10
ALLOC_ETHIDR=10
ALLOC_USDTIDR=35
ALLOC_XAUTIDR=35
ALLOC_DOGEIDR=10

# Trading simulation config
START_CASH_IDR=10000000
ORDER_SIZE_IDR=125000
TRADING_FEE_BPS=30

# Investment cost model for daily cost-vs-profit report
INVESTMENT_HARDWARE_COST_IDR=4500000
INVESTMENT_ELECTRICITY_IDR_PER_KWH=2000
INVESTMENT_POWER_WATT=27
INVESTMENT_AMORTIZATION_DAYS=365

# Risk controls
MAX_POSITION_PER_PAIR_IDR=650000
MAX_PAIR_ALLOCATION_PCT=38
MAX_DAILY_LOSS_PCT=2.6
STOP_LOSS_PCT=2.2
TAKE_PROFIT_PCT=4.0
MAX_DAILY_TRADES=48

# Per-pair drop thresholds for mean reversion fallback
PAIR_DROP_PCT_BTCIDR=3.0
PAIR_DROP_PCT_ETHIDR=4.0
PAIR_DROP_PCT_DOGEIDR=7.0
PAIR_DROP_PCT_USDTIDR=0.5
PAIR_DROP_PCT_XAUTIDR=2.0

# Cooldown in minutes per pair
COOLDOWN_BTCIDR=15
COOLDOWN_ETHIDR=10
COOLDOWN_DOGEIDR=5
COOLDOWN_USDTIDR=5
COOLDOWN_XAUTIDR=10

# ATR / MA indicators
ATR_PERIOD=14
ATR_MULTIPLIER=1.5
ATR_GRID_MULTIPLIER=1.2
MA_PERIOD=50
MA_LONG_PERIOD=200
MA_BUFFER_PCT=0.3
SIDEWAYS_BAND_PCT=1.0
TREND_FILTER_ENABLED=true

# Grid trading settings
GRID_ENABLED=true
GRID_LEVELS=-2,-4,-6,-8,-11,-14,-18,-23
MAX_GRID_LEVELS=8
GRID_TAKE_PROFIT_PCT=2.2

# Profit harvesting
HARVEST_ENABLED=true
HARVEST_LEVELS_PCT=2.2,4.2

# DB-driven auto-learn tuning
AUTO_LEARN_ENABLED=true
AUTO_LEARN_LOOKBACK_DAYS=14
AUTO_LEARN_NOTIFY=true

# Market maker hybrid layer
MARKET_MAKER_ENABLED=true
MARKET_MAKER_LIVE_ENABLED=false
MAKER_REFRESH_SEC=30
MAKER_LEVELS_PCT=0.3,0.6
MAKER_ORDER_SIZE_IDR=45000
MAKER_ATR_SPREAD_MULT=0.4
MAKER_TREND_THRESHOLD_PCT=2.0

# Orderbook imbalance predictor
ORDERBOOK_IMBALANCE_ENABLED=true
ORDERBOOK_IMBALANCE_THRESHOLD_PCT=12.0

# Rebalance controls
REBALANCE_ENABLED=true
REBALANCE_TOLERANCE_PCT=2.0
REBALANCE_INTERVAL_HOURS=24

# Whale-wall filter
WHALE_DETECTION_ENABLED=true
WHALE_WALL_RATIO=2.5
WHALE_CONFIRM_SEC=10

# Liquidity filter
LIQUIDITY_FILTER_ENABLED=false
MIN_TOP5_BID_DEPTH_IDR=200000000

# Customize mode thresholds (used with --customize flag)
CUSTOMIZE_BUY_DROP_PCT=2.0
CUSTOMIZE_SELL_RISE_PCT=3.0

# Live trading safety toggle (default paper mode)
LIVE_TRADING_ENABLED=false

# Indodax private API credentials (required only when LIVE_TRADING_ENABLED=true)
INDODAX_API_KEY=
INDODAX_API_SECRET=
INDODAX_TAPI_URL=https://indodax.com/tapi

# Optional direct Telegram Bot API notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=<token_here>
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=<id_here>
TELEGRAM_CHANNEL=t.me/<channel_here>
REPORT_ENABLED=true
REPORT_INTERVAL=2h

# trading-telegram app bridge
TRADING_TELEGRAM_URL=http://localhost:8082
TRADING_TELEGRAM_BOT_SECRET=changeme-bot-secret

# Mimic natural-language parser (OpenAI first, DeepSeek fallback)
OPENAI_API_KEY=
MIMIC_OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MIMIC_MIN_CONFIDENCE=0.72

# Optional: web dashboard -> HTTP bridge mode (recommended when PHP disables exec/proc_open)
# Example endpoint exposed by cmd/mimic-bridge service:
# MIMIC_WEB_ENDPOINT=http://127.0.0.1:8099/mimic/chat
MIMIC_WEB_ENDPOINT=
# Optional bearer token used by both dashboard and bridge:
MIMIC_WEB_ENDPOINT_TOKEN=
# Optional bridge overrides:
# MIMIC_BRIDGE_COMMAND=C:\Job\clawbot-v2\mimic-clawbot\windows\trading-bot-v3.exe
# MIMIC_BRIDGE_PORT=8099
# MIMIC_BRIDGE_TIMEOUT_SEC=45
